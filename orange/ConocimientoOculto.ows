		<properties node_id="32" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x01\x00\x00\x00\x10\x00\x00\x06\x00\x00\x00\x03?\x00\x00\x00\x02\x00\x00\x00.\x00\x00\x05\xff\x00\x00\x03&gt;\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x02\x00\x00\x00.\x00\x00\x05\xff\x00\x00\x03&gt;', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import re\nimport html\nimport unicodedata\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n\nVIDEO = "dengue_chamo"       \nCOL_TEXTO = "texto"\nCONSERVAR_OTROS_IDIOMAS = False  \nMIN_PALABRAS = 2\nMIN_PALABRAS_IDIOMA = 5\nUMBRAL_STOPWORDS_ES = 0.10\nCARPETA_EVIDENCIA = Path.home() / "salida_limpieza_orange"  \n\n\nPATRONES_SPAM = [\n    r"suscr[ií]be?te", r"suscr[ií]bance", r"sub4sub", r"sorteo", r"gana dinero",\n    r"ganar dinero", r"inversi[oó]n segura", r"criptomoneda", r"bitcoin",\n    r"whatsapp", r"telegram", r"escr[ií]beme al", r"link en mi (perfil|canal)",\n    r"visita mi canal", r"mi canal", r"click aqu[ií]", r"haz clic",\n    r"promoci[oó]n", r"descuento", r"compra ya", r"\\bfirst\\b",\n]\nREGEX_SPAM = re.compile("|".join(PATRONES_SPAM), flags=re.IGNORECASE)\nREGEX_URL = re.compile(r"(https?://\\S+|www\\.\\S+)", flags=re.IGNORECASE)\nREGEX_HTML = re.compile(r"&lt;[^&gt;]+&gt;")\nREGEX_MENCION = re.compile(r"@[\\w\\.\\-]+")\nREGEX_TIEMPO = re.compile(r"\\b\\d{1,2}:\\d{2}(?::\\d{2})?\\b")\nREGEX_EMOJI = re.compile(\n    "[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF\\U0001F1E6-\\U0001F1FF"\n    "\\U0000FE00-\\U0000FE0F\\U0000200D]+", flags=re.UNICODE)\nREGEX_REPETIDOS = re.compile(r"(.)\\1{3,}")\nREGEX_SIN_LETRAS = re.compile(r"^[\\W\\d_]+$", flags=re.UNICODE)\n\nSTOPWORDS_ES = {\n    "de", "la", "que", "el", "en", "y", "a", "los", "del", "se", "las", "por",\n    "un", "para", "con", "no", "una", "su", "al", "lo", "como", "mas", "más",\n    "pero", "sus", "le", "ya", "o", "este", "si", "sí", "porque", "esta",\n    "entre", "cuando", "muy", "sin", "sobre", "tambien", "también", "me",\n    "hasta", "hay", "donde", "quien", "desde", "todo", "nos", "durante",\n    "es", "son", "fue", "ser", "mi", "te", "gracias", "video", "vídeo",\n}\n\ntry:\n    from langdetect import detect, DetectorFactory\n    DetectorFactory.seed = 0\n    HAY_LANGDETECT = True\nexcept Exception:\n    HAY_LANGDETECT = False\n\n\ndef limpiar_texto(t):\n    t = html.unescape(str(t))\n    t = re.sub(r"&lt;br\\s*/?&gt;", " ", t, flags=re.IGNORECASE)\n    t = REGEX_HTML.sub(" ", t)\n    t = REGEX_URL.sub(" ", t)\n    t = REGEX_MENCION.sub(" ", t)\n    t = REGEX_TIEMPO.sub(" ", t)\n    t = REGEX_EMOJI.sub(" ", t)\n    t = unicodedata.normalize("NFC", t)\n    t = REGEX_REPETIDOS.sub(r"\\1\\1", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef clave_duplicado(t):\n    t = unicodedata.normalize("NFKD", t.lower())\n    t = "".join(c for c in t if not unicodedata.combining(c))\n    t = re.sub(r"[^a-z0-9ñ ]", "", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef n_palabras(t):\n    return len(re.findall(r"\\w+", t, flags=re.UNICODE))\n\n\ndef es_espanol(t):\n    palabras = re.findall(r"\\w+", t.lower(), flags=re.UNICODE)\n    if len(palabras) &lt; MIN_PALABRAS_IDIOMA:\n        return True\n    if HAY_LANGDETECT:\n        try:\n            return detect(t) == "es"\n        except Exception:\n            return True\n    prop = sum(p in STOPWORDS_ES for p in palabras) / len(palabras)\n    return prop &gt;= UMBRAL_STOPWORDS_ES\n\n\ndef limpiar(df, col_texto):\n    """Devuelve (limpios, descartados, resumen). No depende de Orange."""\n    df = df.copy().reset_index(drop=True)\n    df["id_registro"] = range(1, len(df) + 1)\n    df["motivo_descarte"] = ""\n    resumen = [("Registros iniciales", len(df))]\n\n    def descartar(mask, motivo, etiqueta):\n        mask = mask &amp; (df["motivo_descarte"] == "")\n        df.loc[mask, "motivo_descarte"] = motivo\n        resumen.append((etiqueta, int(mask.sum())))\n\n    original = df[col_texto].astype("string")\n    descartar(original.isna() | (original.str.strip() == ""), "vacio",\n              "Descartados: vacíos o nulos")\n    df["texto_limpio"] = original.fillna("").map(limpiar_texto)\n    descartar(df["texto_limpio"] == "", "solo_emoji_enlace_o_mencion",\n              "Descartados: solo emojis, enlaces o menciones")\n    descartar(df["texto_limpio"].map(lambda t: bool(REGEX_SIN_LETRAS.match(t))),\n              "solo_numeros_o_simbolos", "Descartados: solo números o símbolos")\n    descartar(original.fillna("").map(lambda t: bool(REGEX_SPAM.search(t))),\n              "spam_o_promocion", "Descartados: spam o promoción")\n    descartar(df["texto_limpio"].map(n_palabras) &lt; MIN_PALABRAS, "muy_corto",\n              "Descartados: menos de %d palabras" % MIN_PALABRAS)\n\n    if not CONSERVAR_OTROS_IDIOMAS:\n        activo = df["motivo_descarte"] == ""\n        no_es = pd.Series(False, index=df.index)\n        no_es[activo] = ~df.loc[activo, "texto_limpio"].map(es_espanol)\n        descartar(no_es, "idioma_no_espanol", "Descartados: idioma distinto al español")\n\n    df["_clave"] = df["texto_limpio"].map(clave_duplicado)\n    activo = df["motivo_descarte"] == ""\n    dup = df[activo].duplicated(subset=["_clave"], keep="first")\n    descartar(pd.Series(df.index.isin(dup[dup].index), index=df.index),\n              "duplicado", "Descartados: duplicados")\n\n    limpios = df[df["motivo_descarte"] == ""].drop(columns=["_clave", "motivo_descarte"])\n    descartados = df[df["motivo_descarte"] != ""].drop(columns=["_clave"])\n    resumen.append(("Registros finales conservados", len(limpios)))\n    return limpios.reset_index(drop=True), descartados, resumen\n\n\n# ===== ORANGE =====\nfrom Orange.data import Domain, Table, StringVariable, ContinuousVariable\nfrom Orange.data.pandas_compat import table_to_frame\n\nif in_data is None:\n    print("Sin datos de entrada: conecte CSV File Import a este widget.")\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n    col = COL_TEXTO if COL_TEXTO in df.columns else next(\n        (c for c in df.columns if df[c].dtype == object), None)\n    if col is None:\n        raise ValueError("No se encontró la columna de texto. Columnas: %s" % list(df.columns))\n\n    limpios, descartados, resumen = limpiar(df, col)\n\n    print("=== LIMPIEZA: %s ===" % VIDEO)\n    for paso, n in resumen:\n        print("%-55s %6d" % (paso, n))\n    print("Detección de idioma:", "langdetect" if HAY_LANGDETECT else "heurística de stopwords")\n\n    # Guardar evidencia (descartados y resumen) para el informe\n    try:\n        CARPETA_EVIDENCIA.mkdir(parents=True, exist_ok=True)\n        descartados.to_csv(CARPETA_EVIDENCIA / ("descartados_%s.csv" % VIDEO),\n                           index=False, encoding="utf-8-sig")\n        pd.DataFrame(resumen, columns=["paso", "cantidad"]).to_csv(\n            CARPETA_EVIDENCIA / ("resumen_%s.csv" % VIDEO), index=False, encoding="utf-8-sig")\n        print("Evidencia guardada en:", CARPETA_EVIDENCIA)\n    except Exception as e:\n        print("No se pudo guardar la evidencia:", e)\n\n    # Construir la tabla de salida (todas las columnas como metas)\n    def serie(nombre):\n        if nombre in limpios.columns:\n            return limpios[nombre].astype(str).fillna("").values\n        return np.array([""] * len(limpios))\n\n    likes = (pd.to_numeric(limpios["likes"], errors="coerce").values\n             if "likes" in limpios.columns else np.full(len(limpios), np.nan))\n\n    domain = Domain([], metas=[\n        StringVariable("video"), StringVariable("texto"),\n        StringVariable("texto_limpio"), StringVariable("fecha"),\n        ContinuousVariable("likes"),\n    ])\n    n = len(limpios)\n    metas = np.empty((n, 5), dtype=object)\n    metas[:, 0] = VIDEO\n    metas[:, 1] = serie(col)\n    metas[:, 2] = serie("texto_limpio")\n    metas[:, 3] = serie("fecha")\n    metas[:, 4] = likes\n    out_data = Table.from_numpy(domain, np.empty((n, 0)), metas=metas)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="33" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import re\nimport html\nimport unicodedata\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n# ---------------------------- CONFIG ---------------------------------------\nVIDEO = "dengue_chamo"          \nCOL_TEXTO = "texto"\nCONSERVAR_OTROS_IDIOMAS = False  \nMIN_PALABRAS = 2\nMIN_PALABRAS_IDIOMA = 5\nUMBRAL_STOPWORDS_ES = 0.10\nCARPETA_EVIDENCIA = Path.home() / "salida_limpieza_orange"   \n# ---------------------------------------------------------------------------\n\nPATRONES_SPAM = [\n    r"suscr[ií]be?te", r"suscr[ií]bance", r"sub4sub", r"sorteo", r"gana dinero",\n    r"ganar dinero", r"inversi[oó]n segura", r"criptomoneda", r"bitcoin",\n    r"whatsapp", r"telegram", r"escr[ií]beme al", r"link en mi (perfil|canal)",\n    r"visita mi canal", r"mi canal", r"click aqu[ií]", r"haz clic",\n    r"promoci[oó]n", r"descuento", r"compra ya", r"\\bfirst\\b",\n]\nREGEX_SPAM = re.compile("|".join(PATRONES_SPAM), flags=re.IGNORECASE)\nREGEX_URL = re.compile(r"(https?://\\S+|www\\.\\S+)", flags=re.IGNORECASE)\nREGEX_HTML = re.compile(r"&lt;[^&gt;]+&gt;")\nREGEX_MENCION = re.compile(r"@[\\w\\.\\-]+")\nREGEX_TIEMPO = re.compile(r"\\b\\d{1,2}:\\d{2}(?::\\d{2})?\\b")\nREGEX_EMOJI = re.compile(\n    "[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF\\U0001F1E6-\\U0001F1FF"\n    "\\U0000FE00-\\U0000FE0F\\U0000200D]+", flags=re.UNICODE)\nREGEX_REPETIDOS = re.compile(r"(.)\\1{3,}")\nREGEX_SIN_LETRAS = re.compile(r"^[\\W\\d_]+$", flags=re.UNICODE)\n\nSTOPWORDS_ES = {\n    "de", "la", "que", "el", "en", "y", "a", "los", "del", "se", "las", "por",\n    "un", "para", "con", "no", "una", "su", "al", "lo", "como", "mas", "más",\n    "pero", "sus", "le", "ya", "o", "este", "si", "sí", "porque", "esta",\n    "entre", "cuando", "muy", "sin", "sobre", "tambien", "también", "me",\n    "hasta", "hay", "donde", "quien", "desde", "todo", "nos", "durante",\n    "es", "son", "fue", "ser", "mi", "te", "gracias", "video", "vídeo",\n}\n\ntry:\n    from langdetect import detect, DetectorFactory\n    DetectorFactory.seed = 0\n    HAY_LANGDETECT = True\nexcept Exception:\n    HAY_LANGDETECT = False\n\n\ndef limpiar_texto(t):\n    t = html.unescape(str(t))\n    t = re.sub(r"&lt;br\\s*/?&gt;", " ", t, flags=re.IGNORECASE)\n    t = REGEX_HTML.sub(" ", t)\n    t = REGEX_URL.sub(" ", t)\n    t = REGEX_MENCION.sub(" ", t)\n    t = REGEX_TIEMPO.sub(" ", t)\n    t = REGEX_EMOJI.sub(" ", t)\n    t = unicodedata.normalize("NFC", t)\n    t = REGEX_REPETIDOS.sub(r"\\1\\1", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef clave_duplicado(t):\n    t = unicodedata.normalize("NFKD", t.lower())\n    t = "".join(c for c in t if not unicodedata.combining(c))\n    t = re.sub(r"[^a-z0-9ñ ]", "", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef n_palabras(t):\n    return len(re.findall(r"\\w+", t, flags=re.UNICODE))\n\n\ndef es_espanol(t):\n    palabras = re.findall(r"\\w+", t.lower(), flags=re.UNICODE)\n    if len(palabras) &lt; MIN_PALABRAS_IDIOMA:\n        return True\n    if HAY_LANGDETECT:\n        try:\n            return detect(t) == "es"\n        except Exception:\n            return True\n    prop = sum(p in STOPWORDS_ES for p in palabras) / len(palabras)\n    return prop &gt;= UMBRAL_STOPWORDS_ES\n\n\ndef limpiar(df, col_texto):\n    """Devuelve (limpios, descartados, resumen). No depende de Orange."""\n    df = df.copy().reset_index(drop=True)\n    df["id_registro"] = range(1, len(df) + 1)\n    df["motivo_descarte"] = ""\n    resumen = [("Registros iniciales", len(df))]\n\n    def descartar(mask, motivo, etiqueta):\n        mask = mask &amp; (df["motivo_descarte"] == "")\n        df.loc[mask, "motivo_descarte"] = motivo\n        resumen.append((etiqueta, int(mask.sum())))\n\n    original = df[col_texto].astype("string")\n    descartar(original.isna() | (original.str.strip() == ""), "vacio",\n              "Descartados: vacíos o nulos")\n    df["texto_limpio"] = original.fillna("").map(limpiar_texto)\n    descartar(df["texto_limpio"] == "", "solo_emoji_enlace_o_mencion",\n              "Descartados: solo emojis, enlaces o menciones")\n    descartar(df["texto_limpio"].map(lambda t: bool(REGEX_SIN_LETRAS.match(t))),\n              "solo_numeros_o_simbolos", "Descartados: solo números o símbolos")\n    descartar(original.fillna("").map(lambda t: bool(REGEX_SPAM.search(t))),\n              "spam_o_promocion", "Descartados: spam o promoción")\n    descartar(df["texto_limpio"].map(n_palabras) &lt; MIN_PALABRAS, "muy_corto",\n              "Descartados: menos de %d palabras" % MIN_PALABRAS)\n\n    if not CONSERVAR_OTROS_IDIOMAS:\n        activo = df["motivo_descarte"] == ""\n        no_es = pd.Series(False, index=df.index)\n        no_es[activo] = ~df.loc[activo, "texto_limpio"].map(es_espanol)\n        descartar(no_es, "idioma_no_espanol", "Descartados: idioma distinto al español")\n\n    df["_clave"] = df["texto_limpio"].map(clave_duplicado)\n    activo = df["motivo_descarte"] == ""\n    dup = df[activo].duplicated(subset=["_clave"], keep="first")\n    descartar(pd.Series(df.index.isin(dup[dup].index), index=df.index),\n              "duplicado", "Descartados: duplicados")\n\n    limpios = df[df["motivo_descarte"] == ""].drop(columns=["_clave", "motivo_descarte"])\n    descartados = df[df["motivo_descarte"] != ""].drop(columns=["_clave"])\n    resumen.append(("Registros finales conservados", len(limpios)))\n    return limpios.reset_index(drop=True), descartados, resumen\n\n\n# ===== ORANGE =====\nfrom Orange.data import Domain, Table, StringVariable, ContinuousVariable\nfrom Orange.data.pandas_compat import table_to_frame\n\nif in_data is None:\n    print("Sin datos de entrada: conecte CSV File Import a este widget.")\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n    col = COL_TEXTO if COL_TEXTO in df.columns else next(\n        (c for c in df.columns if df[c].dtype == object), None)\n    if col is None:\n        raise ValueError("No se encontró la columna de texto. Columnas: %s" % list(df.columns))\n\n    limpios, descartados, resumen = limpiar(df, col)\n\n    print("=== LIMPIEZA: %s ===" % VIDEO)\n    for paso, n in resumen:\n        print("%-55s %6d" % (paso, n))\n    print("Detección de idioma:", "langdetect" if HAY_LANGDETECT else "heurística de stopwords")\n\n    # Guardar evidencia (descartados y resumen) para el informe\n    try:\n        CARPETA_EVIDENCIA.mkdir(parents=True, exist_ok=True)\n        descartados.to_csv(CARPETA_EVIDENCIA / ("descartados_%s.csv" % VIDEO),\n                           index=False, encoding="utf-8-sig")\n        pd.DataFrame(resumen, columns=["paso", "cantidad"]).to_csv(\n            CARPETA_EVIDENCIA / ("resumen_%s.csv" % VIDEO), index=False, encoding="utf-8-sig")\n        print("Evidencia guardada en:", CARPETA_EVIDENCIA)\n    except Exception as e:\n        print("No se pudo guardar la evidencia:", e)\n\n    # Construir la tabla de salida (todas las columnas como metas)\n    def serie(nombre):\n        if nombre in limpios.columns:\n            return limpios[nombre].astype(str).fillna("").values\n        return np.array([""] * len(limpios))\n\n    likes = (pd.to_numeric(limpios["likes"], errors="coerce").values\n             if "likes" in limpios.columns else np.full(len(limpios), np.nan))\n\n    domain = Domain([], metas=[\n        StringVariable("video"), StringVariable("texto"),\n        StringVariable("texto_limpio"), StringVariable("fecha"),\n        ContinuousVariable("likes"),\n    ])\n    n = len(limpios)\n    metas = np.empty((n, 5), dtype=object)\n    metas[:, 0] = VIDEO\n    metas[:, 1] = serie(col)\n    metas[:, 2] = serie("texto_limpio")\n    metas[:, 3] = serie("fecha")\n    metas[:, 4] = likes\n    out_data = Table.from_numpy(domain, np.empty((n, 0)), metas=metas)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="34" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00Z\x00\x00\x04\x90\x00\x00\x02\xb8\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import re\nimport html\nimport unicodedata\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n# ---------------------------- CONFIG ---------------------------------------\nVIDEO = "dengue_chamo"          # &lt;- cambiar en cada flujo\nCOL_TEXTO = "texto"\nCONSERVAR_OTROS_IDIOMAS = False  # True = no descartar comentarios en otros idiomas\nMIN_PALABRAS = 2\nMIN_PALABRAS_IDIOMA = 5\nUMBRAL_STOPWORDS_ES = 0.10\nCARPETA_EVIDENCIA = Path.home() / "salida_limpieza_orange"   # descartados y resumen\n# ---------------------------------------------------------------------------\n\nPATRONES_SPAM = [\n    r"suscr[ií]be?te", r"suscr[ií]bance", r"sub4sub", r"sorteo", r"gana dinero",\n    r"ganar dinero", r"inversi[oó]n segura", r"criptomoneda", r"bitcoin",\n    r"whatsapp", r"telegram", r"escr[ií]beme al", r"link en mi (perfil|canal)",\n    r"visita mi canal", r"mi canal", r"click aqu[ií]", r"haz clic",\n    r"promoci[oó]n", r"descuento", r"compra ya", r"\\bfirst\\b",\n]\nREGEX_SPAM = re.compile("|".join(PATRONES_SPAM), flags=re.IGNORECASE)\nREGEX_URL = re.compile(r"(https?://\\S+|www\\.\\S+)", flags=re.IGNORECASE)\nREGEX_HTML = re.compile(r"&lt;[^&gt;]+&gt;")\nREGEX_MENCION = re.compile(r"@[\\w\\.\\-]+")\nREGEX_TIEMPO = re.compile(r"\\b\\d{1,2}:\\d{2}(?::\\d{2})?\\b")\nREGEX_EMOJI = re.compile(\n    "[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF\\U0001F1E6-\\U0001F1FF"\n    "\\U0000FE00-\\U0000FE0F\\U0000200D]+", flags=re.UNICODE)\nREGEX_REPETIDOS = re.compile(r"(.)\\1{3,}")\nREGEX_SIN_LETRAS = re.compile(r"^[\\W\\d_]+$", flags=re.UNICODE)\n\nSTOPWORDS_ES = {\n    "de", "la", "que", "el", "en", "y", "a", "los", "del", "se", "las", "por",\n    "un", "para", "con", "no", "una", "su", "al", "lo", "como", "mas", "más",\n    "pero", "sus", "le", "ya", "o", "este", "si", "sí", "porque", "esta",\n    "entre", "cuando", "muy", "sin", "sobre", "tambien", "también", "me",\n    "hasta", "hay", "donde", "quien", "desde", "todo", "nos", "durante",\n    "es", "son", "fue", "ser", "mi", "te", "gracias", "video", "vídeo",\n}\n\ntry:\n    from langdetect import detect, DetectorFactory\n    DetectorFactory.seed = 0\n    HAY_LANGDETECT = True\nexcept Exception:\n    HAY_LANGDETECT = False\n\n\ndef limpiar_texto(t):\n    t = html.unescape(str(t))\n    t = re.sub(r"&lt;br\\s*/?&gt;", " ", t, flags=re.IGNORECASE)\n    t = REGEX_HTML.sub(" ", t)\n    t = REGEX_URL.sub(" ", t)\n    t = REGEX_MENCION.sub(" ", t)\n    t = REGEX_TIEMPO.sub(" ", t)\n    t = REGEX_EMOJI.sub(" ", t)\n    t = unicodedata.normalize("NFC", t)\n    t = REGEX_REPETIDOS.sub(r"\\1\\1", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef clave_duplicado(t):\n    t = unicodedata.normalize("NFKD", t.lower())\n    t = "".join(c for c in t if not unicodedata.combining(c))\n    t = re.sub(r"[^a-z0-9ñ ]", "", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef n_palabras(t):\n    return len(re.findall(r"\\w+", t, flags=re.UNICODE))\n\n\ndef es_espanol(t):\n    palabras = re.findall(r"\\w+", t.lower(), flags=re.UNICODE)\n    if len(palabras) &lt; MIN_PALABRAS_IDIOMA:\n        return True\n    if HAY_LANGDETECT:\n        try:\n            return detect(t) == "es"\n        except Exception:\n            return True\n    prop = sum(p in STOPWORDS_ES for p in palabras) / len(palabras)\n    return prop &gt;= UMBRAL_STOPWORDS_ES\n\n\ndef limpiar(df, col_texto):\n    """Devuelve (limpios, descartados, resumen). No depende de Orange."""\n    df = df.copy().reset_index(drop=True)\n    df["id_registro"] = range(1, len(df) + 1)\n    df["motivo_descarte"] = ""\n    resumen = [("Registros iniciales", len(df))]\n\n    def descartar(mask, motivo, etiqueta):\n        mask = mask &amp; (df["motivo_descarte"] == "")\n        df.loc[mask, "motivo_descarte"] = motivo\n        resumen.append((etiqueta, int(mask.sum())))\n\n    original = df[col_texto].astype("string")\n    descartar(original.isna() | (original.str.strip() == ""), "vacio",\n              "Descartados: vacíos o nulos")\n    df["texto_limpio"] = original.fillna("").map(limpiar_texto)\n    descartar(df["texto_limpio"] == "", "solo_emoji_enlace_o_mencion",\n              "Descartados: solo emojis, enlaces o menciones")\n    descartar(df["texto_limpio"].map(lambda t: bool(REGEX_SIN_LETRAS.match(t))),\n              "solo_numeros_o_simbolos", "Descartados: solo números o símbolos")\n    descartar(original.fillna("").map(lambda t: bool(REGEX_SPAM.search(t))),\n              "spam_o_promocion", "Descartados: spam o promoción")\n    descartar(df["texto_limpio"].map(n_palabras) &lt; MIN_PALABRAS, "muy_corto",\n              "Descartados: menos de %d palabras" % MIN_PALABRAS)\n\n    if not CONSERVAR_OTROS_IDIOMAS:\n        activo = df["motivo_descarte"] == ""\n        no_es = pd.Series(False, index=df.index)\n        no_es[activo] = ~df.loc[activo, "texto_limpio"].map(es_espanol)\n        descartar(no_es, "idioma_no_espanol", "Descartados: idioma distinto al español")\n\n    df["_clave"] = df["texto_limpio"].map(clave_duplicado)\n    activo = df["motivo_descarte"] == ""\n    dup = df[activo].duplicated(subset=["_clave"], keep="first")\n    descartar(pd.Series(df.index.isin(dup[dup].index), index=df.index),\n              "duplicado", "Descartados: duplicados")\n\n    limpios = df[df["motivo_descarte"] == ""].drop(columns=["_clave", "motivo_descarte"])\n    descartados = df[df["motivo_descarte"] != ""].drop(columns=["_clave"])\n    resumen.append(("Registros finales conservados", len(limpios)))\n    return limpios.reset_index(drop=True), descartados, resumen\n\n\n# ===== ORANGE =====\nfrom Orange.data import Domain, Table, StringVariable, ContinuousVariable\nfrom Orange.data.pandas_compat import table_to_frame\n\nif in_data is None:\n    print("Sin datos de entrada: conecte CSV File Import a este widget.")\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n    col = COL_TEXTO if COL_TEXTO in df.columns else next(\n        (c for c in df.columns if df[c].dtype == object), None)\n    if col is None:\n        raise ValueError("No se encontró la columna de texto. Columnas: %s" % list(df.columns))\n\n    limpios, descartados, resumen = limpiar(df, col)\n\n    print("=== LIMPIEZA: %s ===" % VIDEO)\n    for paso, n in resumen:\n        print("%-55s %6d" % (paso, n))\n    print("Detección de idioma:", "langdetect" if HAY_LANGDETECT else "heurística de stopwords")\n\n    # Guardar evidencia (descartados y resumen) para el informe\n    try:\n        CARPETA_EVIDENCIA.mkdir(parents=True, exist_ok=True)\n        descartados.to_csv(CARPETA_EVIDENCIA / ("descartados_%s.csv" % VIDEO),\n                           index=False, encoding="utf-8-sig")\n        pd.DataFrame(resumen, columns=["paso", "cantidad"]).to_csv(\n            CARPETA_EVIDENCIA / ("resumen_%s.csv" % VIDEO), index=False, encoding="utf-8-sig")\n        print("Evidencia guardada en:", CARPETA_EVIDENCIA)\n    except Exception as e:\n        print("No se pudo guardar la evidencia:", e)\n\n    # Construir la tabla de salida (todas las columnas como metas)\n    def serie(nombre):\n        if nombre in limpios.columns:\n            return limpios[nombre].astype(str).fillna("").values\n        return np.array([""] * len(limpios))\n\n    likes = (pd.to_numeric(limpios["likes"], errors="coerce").values\n             if "likes" in limpios.columns else np.full(len(limpios), np.nan))\n\n    domain = Domain([], metas=[\n        StringVariable("video"), StringVariable("texto"),\n        StringVariable("texto_limpio"), StringVariable("fecha"),\n        ContinuousVariable("likes"),\n    ])\n    n = len(limpios)\n    metas = np.empty((n, 5), dtype=object)\n    metas[:, 0] = VIDEO\n    metas[:, 1] = serie(col)\n    metas[:, 2] = serie("texto_limpio")\n    metas[:, 3] = serie("fecha")\n    metas[:, 4] = likes\n    out_data = Table.from_numpy(domain, np.empty((n, 0)), metas=metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="35" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x01\x00\x00\x00\x10\x00\x00\x06\x00\x00\x00\x03?\x00\x00\x00\x02\x00\x00\x00.\x00\x00\x05\xff\x00\x00\x03&gt;\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x02\x00\x00\x00.\x00\x00\x05\xff\x00\x00\x03&gt;', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import re\nimport html\nimport unicodedata\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n\nVIDEO = "dengue_chamo"\nCOL_TEXTO = "texto"\nCONSERVAR_OTROS_IDIOMAS = False  \nMIN_PALABRAS = 2\nMIN_PALABRAS_IDIOMA = 5\nUMBRAL_STOPWORDS_ES = 0.10\nCARPETA_EVIDENCIA = Path.home() / "salida_limpieza_orange"   \n\n\nPATRONES_SPAM = [\n    r"suscr[ií]be?te", r"suscr[ií]bance", r"sub4sub", r"sorteo", r"gana dinero",\n    r"ganar dinero", r"inversi[oó]n segura", r"criptomoneda", r"bitcoin",\n    r"whatsapp", r"telegram", r"escr[ií]beme al", r"link en mi (perfil|canal)",\n    r"visita mi canal", r"mi canal", r"click aqu[ií]", r"haz clic",\n    r"promoci[oó]n", r"descuento", r"compra ya", r"\\bfirst\\b",\n]\nREGEX_SPAM = re.compile("|".join(PATRONES_SPAM), flags=re.IGNORECASE)\nREGEX_URL = re.compile(r"(https?://\\S+|www\\.\\S+)", flags=re.IGNORECASE)\nREGEX_HTML = re.compile(r"&lt;[^&gt;]+&gt;")\nREGEX_MENCION = re.compile(r"@[\\w\\.\\-]+")\nREGEX_TIEMPO = re.compile(r"\\b\\d{1,2}:\\d{2}(?::\\d{2})?\\b")\nREGEX_EMOJI = re.compile(\n    "[\\U0001F300-\\U0001FAFF\\U00002600-\\U000027BF\\U0001F1E6-\\U0001F1FF"\n    "\\U0000FE00-\\U0000FE0F\\U0000200D]+", flags=re.UNICODE)\nREGEX_REPETIDOS = re.compile(r"(.)\\1{3,}")\nREGEX_SIN_LETRAS = re.compile(r"^[\\W\\d_]+$", flags=re.UNICODE)\n\nSTOPWORDS_ES = {\n    "de", "la", "que", "el", "en", "y", "a", "los", "del", "se", "las", "por",\n    "un", "para", "con", "no", "una", "su", "al", "lo", "como", "mas", "más",\n    "pero", "sus", "le", "ya", "o", "este", "si", "sí", "porque", "esta",\n    "entre", "cuando", "muy", "sin", "sobre", "tambien", "también", "me",\n    "hasta", "hay", "donde", "quien", "desde", "todo", "nos", "durante",\n    "es", "son", "fue", "ser", "mi", "te", "gracias", "video", "vídeo",\n}\n\ntry:\n    from langdetect import detect, DetectorFactory\n    DetectorFactory.seed = 0\n    HAY_LANGDETECT = True\nexcept Exception:\n    HAY_LANGDETECT = False\n\n\ndef limpiar_texto(t):\n    t = html.unescape(str(t))\n    t = re.sub(r"&lt;br\\s*/?&gt;", " ", t, flags=re.IGNORECASE)\n    t = REGEX_HTML.sub(" ", t)\n    t = REGEX_URL.sub(" ", t)\n    t = REGEX_MENCION.sub(" ", t)\n    t = REGEX_TIEMPO.sub(" ", t)\n    t = REGEX_EMOJI.sub(" ", t)\n    t = unicodedata.normalize("NFC", t)\n    t = REGEX_REPETIDOS.sub(r"\\1\\1", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef clave_duplicado(t):\n    t = unicodedata.normalize("NFKD", t.lower())\n    t = "".join(c for c in t if not unicodedata.combining(c))\n    t = re.sub(r"[^a-z0-9ñ ]", "", t)\n    return re.sub(r"\\s+", " ", t).strip()\n\n\ndef n_palabras(t):\n    return len(re.findall(r"\\w+", t, flags=re.UNICODE))\n\n\ndef es_espanol(t):\n    palabras = re.findall(r"\\w+", t.lower(), flags=re.UNICODE)\n    if len(palabras) &lt; MIN_PALABRAS_IDIOMA:\n        return True\n    if HAY_LANGDETECT:\n        try:\n            return detect(t) == "es"\n        except Exception:\n            return True\n    prop = sum(p in STOPWORDS_ES for p in palabras) / len(palabras)\n    return prop &gt;= UMBRAL_STOPWORDS_ES\n\n\ndef limpiar(df, col_texto):\n    """Devuelve (limpios, descartados, resumen). No depende de Orange."""\n    df = df.copy().reset_index(drop=True)\n    df["id_registro"] = range(1, len(df) + 1)\n    df["motivo_descarte"] = ""\n    resumen = [("Registros iniciales", len(df))]\n\n    def descartar(mask, motivo, etiqueta):\n        mask = mask &amp; (df["motivo_descarte"] == "")\n        df.loc[mask, "motivo_descarte"] = motivo\n        resumen.append((etiqueta, int(mask.sum())))\n\n    original = df[col_texto].astype("string")\n    descartar(original.isna() | (original.str.strip() == ""), "vacio",\n              "Descartados: vacíos o nulos")\n    df["texto_limpio"] = original.fillna("").map(limpiar_texto)\n    descartar(df["texto_limpio"] == "", "solo_emoji_enlace_o_mencion",\n              "Descartados: solo emojis, enlaces o menciones")\n    descartar(df["texto_limpio"].map(lambda t: bool(REGEX_SIN_LETRAS.match(t))),\n              "solo_numeros_o_simbolos", "Descartados: solo números o símbolos")\n    descartar(original.fillna("").map(lambda t: bool(REGEX_SPAM.search(t))),\n              "spam_o_promocion", "Descartados: spam o promoción")\n    descartar(df["texto_limpio"].map(n_palabras) &lt; MIN_PALABRAS, "muy_corto",\n              "Descartados: menos de %d palabras" % MIN_PALABRAS)\n\n    if not CONSERVAR_OTROS_IDIOMAS:\n        activo = df["motivo_descarte"] == ""\n        no_es = pd.Series(False, index=df.index)\n        no_es[activo] = ~df.loc[activo, "texto_limpio"].map(es_espanol)\n        descartar(no_es, "idioma_no_espanol", "Descartados: idioma distinto al español")\n\n    df["_clave"] = df["texto_limpio"].map(clave_duplicado)\n    activo = df["motivo_descarte"] == ""\n    dup = df[activo].duplicated(subset=["_clave"], keep="first")\n    descartar(pd.Series(df.index.isin(dup[dup].index), index=df.index),\n              "duplicado", "Descartados: duplicados")\n\n    limpios = df[df["motivo_descarte"] == ""].drop(columns=["_clave", "motivo_descarte"])\n    descartados = df[df["motivo_descarte"] != ""].drop(columns=["_clave"])\n    resumen.append(("Registros finales conservados", len(limpios)))\n    return limpios.reset_index(drop=True), descartados, resumen\n\n\n\nfrom Orange.data import Domain, Table, StringVariable, ContinuousVariable\nfrom Orange.data.pandas_compat import table_to_frame\n\nif in_data is None:\n    print("Sin datos de entrada: conecte CSV File Import a este widget.")\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n    col = COL_TEXTO if COL_TEXTO in df.columns else next(\n        (c for c in df.columns if df[c].dtype == object), None)\n    if col is None:\n        raise ValueError("No se encontró la columna de texto. Columnas: %s" % list(df.columns))\n\n    limpios, descartados, resumen = limpiar(df, col)\n\n    print("=== LIMPIEZA: %s ===" % VIDEO)\n    for paso, n in resumen:\n        print("%-55s %6d" % (paso, n))\n    print("Detección de idioma:", "langdetect" if HAY_LANGDETECT else "heurística de stopwords")\n\n    \n    try:\n        CARPETA_EVIDENCIA.mkdir(parents=True, exist_ok=True)\n        descartados.to_csv(CARPETA_EVIDENCIA / ("descartados_%s.csv" % VIDEO),\n                           index=False, encoding="utf-8-sig")\n        pd.DataFrame(resumen, columns=["paso", "cantidad"]).to_csv(\n            CARPETA_EVIDENCIA / ("resumen_%s.csv" % VIDEO), index=False, encoding="utf-8-sig")\n        print("Evidencia guardada en:", CARPETA_EVIDENCIA)\n    except Exception as e:\n        print("No se pudo guardar la evidencia:", e)\n\n  \n    def serie(nombre):\n        if nombre in limpios.columns:\n            return limpios[nombre].astype(str).fillna("").values\n        return np.array([""] * len(limpios))\n\n    likes = (pd.to_numeric(limpios["likes"], errors="coerce").values\n             if "likes" in limpios.columns else np.full(len(limpios), np.nan))\n\n    domain = Domain([], metas=[\n        StringVariable("video"), StringVariable("texto"),\n        StringVariable("texto_limpio"), StringVariable("fecha"),\n        ContinuousVariable("likes"),\n    ])\n    n = len(limpios)\n    metas = np.empty((n, 5), dtype=object)\n    metas[:, 0] = VIDEO\n    metas[:, 1] = serie(col)\n    metas[:, 2] = serie("texto_limpio")\n    metas[:, 3] = serie("fecha")\n    metas[:, 4] = likes\n    out_data = Table.from_numpy(domain, np.empty((n, 0)), metas=metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
